# NOTE: Django loyihasining maxfiy kaliti. Kamida 50 belgidan iborat tasodifiy string bo'lishi kerak.
# TAVSIYA: openssl rand -base64 50 yoki python -c "import secrets; print(secrets.token_urlsafe(50))" orqali generatsiya qiling.
DJANGO_SECRET_KEY=

# NOTE: Debug holati (true/false). Ishlab chiqarishda 'false' bo'lishi shart.
DEBUG=

# NOTE: Ruxsat etilgan hostlar (vergul bilan ajratilgan). Domen nomingizni yoki IP manzilingizni kiriting.
ALLOWED_HOSTS=

# NOTE: Ma'lumotlar bazasi dvigateli. Odatda 'django.db.backends.postgresql'
DB_ENGINE=
# NOTE: Ma'lumotlar bazasi nomi
DB_NAME=
# NOTE: Ma'lumotlar bazasi foydalanuvchisi
DB_USER=
# NOTE: Ma'lumotlar bazasi paroli. Xavfsiz parol kiriting.
# TAVSIYA: Kamida 12 belgidan iborat, katta/kichik harflar, raqamlar va maxsus belgilar aralashmasidan foydalaning.
DB_PASSWORD=
# NOTE: Ma'lumotlar bazasi hosti. Odatda 'localhost' yoki Docker servisi nomi.
DB_HOST=
# NOTE: Ma'lumotlar bazasi porti. PostgreSQL uchun odatda 5432.
DB_PORT=

# NOTE: REST Framework sahifa hajmi (integer). API ro'yxatlari uchun standart elementlar soni.
REST_FRAMEWORK_PAGE_SIZE=

# NOTE: JWT Access Token muddati (daqiqa, integer). Odatda qisqa muddat (masalan, 5-15 daqiqa).
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=
# NOTE: JWT Refresh Token muddati (kun, integer). Odatda uzoq muddat (masalan, 30 kun).
JWT_REFRESH_TOKEN_LIFETIME_DAYS=
# NOTE: Refresh tokenlarni aylantirish (true/false). Xavfsizlikni oshiradi.
JWT_ROTATE_REFRESH_TOKENS=
# NOTE: Aylantirilgandan keyin qora ro'yxatga kiritish (true/false). Xavfsizlikni oshiradi.
JWT_BLACKLIST_AFTER_ROTATION=
# NOTE: Oxirgi kirish vaqtini yangilash (true/false).
JWT_UPDATE_LAST_LOGIN=
# NOTE: JWT imzolash kaliti. Kamida 32 belgidan iborat tasodifiy string bo'lishi kerak.
# TAVSIYA: openssl rand -base64 32 yoki python -c "import secrets; print(secrets.token_urlsafe(32))" orqali generatsiya qiling.
JWT_SIGNING_KEY=
# NOTE: Sliding token muddati (daqiqa, integer).
JWT_SLIDING_TOKEN_LIFETIME_MINUTES=
# NOTE: Sliding token refresh muddati (kun, integer).
JWT_SLIDING_TOKEN_REFRESH_LIFETIME_DAYS=

# NOTE: CORS Headers: Ruxsat etilgan originlar (vergul bilan ajratilgan).
# TAVSIYA: Faqat sizning frontend domeningizni kiriting. Masalan: http://127.0.0.1:8000,https://onlinepharmacy.uz
CORS_ALLOWED_ORIGINS=
# NOTE: CORS Headers: Barcha originlarga ruxsat berish (true/false). Ishlab chiqarishda 'false' bo'lishi va CORS_ALLOWED_ORIGINS o'rnatilishi tavsiya etiladi.
CORS_ALLOW_ALL_ORIGINS=

# NOTE: Standart telefon raqami mintaqasi (masalan, UZ, US, GB).
PHONENUMBER_DEFAULT_REGION=

# NOTE: Autentifikatsiya Telegram bot tokeni. BotFather dan olingan token.
AUTH_BOT_TOKEN=
# NOTE: Telegram webhook maxfiy kaliti. Tasodifiy string bo'lishi kerak.
# TAVSIYA: openssl rand -base64 32 yoki python -c "import secrets; print(secrets.token_urlsafe(32))" orqali generatsiya qiling.
TELEGRAM_WEBHOOK_SECRET=
# NOTE: API bazaviy URL manzili. Loyihaning tashqi URL manzili.
API_BASE_URL=

# NOTE: Email backend klassi. Odatda 'django.core.mail.backends.smtp.EmailBackend'.
EMAIL_BACKEND=
# NOTE: Email server hosti (masalan, smtp.gmail.com).
EMAIL_HOST=
# NOTE: Email server porti (masalan, 587 (TLS) yoki 465 (SSL)).
EMAIL_PORT=
# NOTE: TLS (Transport Layer Security) ishlatilsinmi (true/false).
EMAIL_USE_TLS=
# NOTE: SSL (Secure Sockets Layer) ishlatilsinmi (true/false).
EMAIL_USE_SSL=
# NOTE: Email serveriga kirish uchun foydalanuvchi nomi.
EMAIL_HOST_USER=
# NOTE: Email serveriga kirish uchun parol.
# TAVSIYA: Email provayderingizdan ilova parolini (App Password) generatsiya qiling. Asosiy parolingizni ishlatmang.
EMAIL_HOST_PASSWORD=
# NOTE: Standart jo'natuvchi email manzili.
DEFAULT_FROM_EMAIL=

# NOTE: Log fayl yo'li (masalan, /var/log/onlinepharmacy/django.log). Ishlab chiqarishda muhim.
LOG_FILE=
# NOTE: Umumiy log darajasi (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=
# NOTE: Django log darajasi.
DJANGO_LOG_LEVEL=
# NOTE: Django request log darajasi.
DJANGO_REQUEST_LOG_LEVEL=

# NOTE: Ish haqi hisoblashda soatlik stavka (float).
PAYROLL_RATE_PER_HOUR=
# NOTE: Ish haqi hisoblashda soliq stavkasi (float).
PAYROLL_TAX_RATE=

# NOTE: Stripe maxfiy kaliti.
STRIPE_SECRET_KEY=

# NOTE: Google AI API kaliti.
GOOGLE_AI_API_KEY=

# NOTE: Celery broker URL manzili (masalan, redis://redis:6379/0).
CELERY_BROKER_URL=
# NOTE: Celery natijalar backend URL manzili (masalan, redis://redis:6379/0).
CELERY_RESULT_BACKEND=
# NOTE: Celery qabul qilinadigan kontent turlari (vergul bilan ajratilgan).
CELERY_ACCEPT_CONTENT=
# NOTE: Celery task serializer (masalan, json).
CELERY_TASK_SERIALIZER=