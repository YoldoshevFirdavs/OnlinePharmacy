# ============================================================================
# ENVIRONMENT VARIABLES - PRODUCTION TEMPLATE
# Copy this to .env and fill in with production values
# ============================================================================

# Django Configuration
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_ALLOWED_HOSTS=onlinepharmacy.uz,www.onlinepharmacy.uz
ENVIRONMENT=production

# Database (PostgreSQL)
DB_NAME=pharmacy_db_prod
DB_USER=pharmacy_admin_prod
DB_PASSWORD=your-db-password-here
DB_HOST=db
DB_PORT=5432

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Stripe API (Production Keys)
STRIPE_SECRET_KEY=sk_live_your-live-key-here
STRIPE_PUBLIC_KEY=pk_live_your-live-key-here

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json

# Telegram Bot (Production)
MAIN_BOT_TOKEN=your-main-bot-token
AUTH_BOT_TOKEN=your-auth-bot-token
ADMIN_ID=your-admin-id
AUTH_BOT_USERNAME=@your_bot_username

# Social Links
SOCIAL_TELEGRAM_URL=https://t.me/yourprofile
SOCIAL_TELEGRAM_ICON=/static/images/icons/telegram.png
SOCIAL_INSTAGRAM_URL=https://instagram.com/yourprofile
SOCIAL_INSTAGRAM_ICON=/static/images/icons/instagram.png
SOCIAL_FACEBOOK_URL=https://facebook.com/yourpage
SOCIAL_FACEBOOK_ICON=/static/images/icons/facebook.png

# CORS
CORS_ORIGINS=https://onlinepharmacy.uz,https://www.onlinepharmacy.uz
CORS_ALLOWED_ORIGINS=https://onlinepharmacy.uz,https://www.onlinepharmacy.uz
CORS_ALLOW_ALL_ORIGINS=False

# JWT Settings
JWT_SECRET=your-jwt-secret-key
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_UPDATE_LAST_LOGIN=True
JWT_SIGNING_KEY=your-jwt-signing-key
JWT_SLIDING_TOKEN_LIFETIME_MINUTES=60
JWT_SLIDING_TOKEN_REFRESH_LIFETIME_DAYS=7

# Logging
LOG_FILE=/app/logs/django.log
LOG_LEVEL=WARNING
DJANGO_LOG_LEVEL=WARNING
DJANGO_REQUEST_LOG_LEVEL=WARNING

# Language & Timezone
LANGUAGE_CODE=uz
TIME_ZONE=Asia/Tashkent
REST_FRAMEWORK_PAGE_SIZE=10

# Phone Number
PHONENUMBER_DEFAULT_REGION=UZ

# Telegram Webhook
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Payroll
PAYROLL_RATE_PER_HOUR=223
PAYROLL_TAX_RATE=0.13

# Email Debug
EMAIL_DEBUG_PRINT=False
SITE_URL=https://onlinepharmacy.uz

# Google AI
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Static & Media (Docker volumes)
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# Security (Production)
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_PROXY_SSL_HEADER=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Device Fingerprint Security
FINGERPRINT_RATE_THRESHOLD=10
FINGERPRINT_TEMP_BAN_DURATION=60
FINGERPRINT_IP_BLOCK_DURATION=3600
FINGERPRINT_MAIN_PAGE_REFRESH_LIMIT=20
FINGERPRINT_BAN_CACHE_TTL=86400
FINGERPRINT_USER_MAPPING_TTL=86400
FINGERPRINT_AUTO_CLEANUP_ENABLED=True
FINGERPRINT_CLEANUP_BATCH_SIZE=100
FINGERPRINT_REQUIRE_HTTPS_COOKIE=True
FINGERPRINT_COOKIE_SAMESITE=Strict
FINGERPRINT_HEADER_NAME=Authorization-Fingerprint
FINGERPRINT_LOG_LEVEL=WARNING
FINGERPRINT_LOG_BLOCKED_REQUESTS=True
FINGERPRINT_LOG_RATE_LIMITS=True