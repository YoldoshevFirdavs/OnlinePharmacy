services:
  db:
    image: postgres:15
    volumes:
      - postgres_data:/var/lib/postgresql/data/
    env_file:
      - .env
    environment:
      POSTGRES_DB: ${DB_NAME}
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    ports:
      - "5432:5432"
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U ${DB_USER} -d ${DB_NAME}" ]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: [ "CMD", "redis-cli", "ping" ]
      interval: 10s
      timeout: 5s
      retries: 5

  web:
    build: .
    command: sh -c "python manage.py migrate --noinput && python manage.py collectstatic --noinput && gunicorn config.wsgi --bind 0.0.0.0:8000 --workers 2 --timeout 60"
    volumes:
      - .:/app
      - static_volume:/app/staticfiles
      - media_volume:/app/media
      - logs_volume:/app/logs
    expose:
      - "8000"
    env_file:
      - .env
    environment:
      - PYTHONUNBUFFERED=1
      - LOG_FILE=/app/logs/django.log
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: [ "CMD-SHELL", "python -c \"import socket; s=socket.socket(); s.connect(('127.0.0.1',8000)); s.close()\"" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

  # nginx: [COMMENTED OUT - App runs standalone without reverse proxy]
  # image: nginx:latest
  # ports:
  #   - "80:80"
  #   # Uncomment for production only (requires nginx.conf with SSL):
  #   # - "443:443"
  # volumes:
  #   - ./nginx/nginx.dev.conf:/etc/nginx/conf.d/default.conf:ro # LOCAL DEV
  #   # Production: swap the line above for the line below:
  #   # - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
  #   - ./certs:/etc/nginx/certs:ro
  #   - static_volume:/app/staticfiles:ro
  #   - media_volume:/app/media:ro
  # depends_on:
  #   web:
  #     # nginx only starts after Gunicorn is confirmed healthy
  #     condition: service_healthy

  celery:
    build: .
    command: celery -A config worker --loglevel=info --concurrency=1 --max-tasks-per-child=1000
    volumes:
      - .:/app
      - media_volume:/app/media
    env_file:
      - .env
    environment:
      - PYTHONUNBUFFERED=1
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      web:
        condition: service_started

  auth_bot:
    build: .
    command: python telegram_bot/runbot1.py
    volumes:
      - .:/app
    env_file:
      - .env
    environment:
      - PYTHONUNBUFFERED=1
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      web:
        condition: service_started
  bugsink:
    image: bugsink/bugsink:latest
    container_name: bugsink
    profiles: ["dev"]
    ports:
      - "8010:8000"
    environment:
      - SECRET_KEY=this-is-a-very-long-secret-key-that-is-definitely-more-than-50-characters-long-for-bugsink-local
      - CREATE_SUPERUSER=admin@example.org:admin
      - PORT=8000
      - DB_ENGINE=postgresql
      - DB_HOST=${BUGSINK_DB_HOST:-db}
      - DB_PORT=${BUGSINK_DB_PORT:-5432}
      - DB_USER=${BUGSINK_DB_USER:-bugsink_user}
      - DB_PASSWORD=${BUGSINK_DB_PASSWORD:-bugsink_pass}
      - DB_NAME=${BUGSINK_DB_NAME:-bugsink_db}
      - DEBUG=False
    volumes:
      - bugsink_data:/app/data
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000" ]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

  prometheus:
    image: prom/prometheus
    container_name: prometheus
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
    restart: always
    networks:
      - default

  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    ports:
      - "3000:3000"
    volumes:
      - grafana_data:/var/lib/grafana
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=admin
      - GF_SECURITY_ADMIN_USER=admin
      - GF_INSTALL_PLUGINS=grafana-clock-panel
    restart: always
    depends_on:
      - prometheus
    networks:
      - default

  

volumes:
  postgres_data:
  redis_data:
  static_volume:
  media_volume:
  logs_volume:
  grafana_data:
  prometheus_data:
  bugsink_data:
 
networks:
  default:
    driver: bridge
